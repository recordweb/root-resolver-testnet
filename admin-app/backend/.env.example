# Beispiel-Konfiguration – kopieren nach .env und bei Bedarf anpassen.
# Alle Werte haben Defaults in src/config.js (passend zum Testnetz dieses Repos).

# Fabric-Netzwerk
CHANNEL_NAME=root-resolver
CHAINCODE_NAME=namespace-registry

# Peer-Endpoint (im fabric_net-Docker-Netz ist der Container-Name auflösbar).
# Für lokalen Zugriff via Portmapping: PEER_ENDPOINT=localhost:7051 setzen,
# PEER_HOST_ALIAS aber auf dem Zertifikatsnamen belassen.
PEER_ENDPOINT=peer0.org.recordweb.dev:7951
PEER_HOST_ALIAS=peer0.org.recordweb.dev

# Organisation, in deren Namen signiert wird
MSP_ID=RecordWebOrgMSP

# Kryptomaterial (Defaults zeigen auf network/crypto-config/…)
# PEER_TLS_CA_PATH=/absoluter/pfad/zu/peer0.recordweb.org/tls/ca.crt
# CERT_PATH=/absoluter/pfad/zu/Admin@recordweb.org-cert.pem
# KEY_PATH=/absoluter/pfad/zu/Admin@recordweb.org/msp/keystore

# HTTP-Server
PORT=3000
